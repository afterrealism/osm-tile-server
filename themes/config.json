{
  "options": {
    "paths": {
      "root": "/data",
      "styles": "style-assets",
      "fonts": "style-assets/fonts",
      "sprites": "style-assets",
      "pmtiles": "openmaptiles"
    },
    "frontPage": false,
    "allowedHosts": "localhost,127.0.0.1",
    "maxScaleFactor": 1,
    "minRendererPoolSizes": [
      2
    ],
    "maxRendererPoolSizes": [
      8
    ],
    "serveStaticMaps": false
  },
  "styles": {
    "atlas": {
      "style": "atlas/style.json",
      "serve_rendered": true,
      "serve_data": false
    },
    "paper": {
      "style": "paper/style.json",
      "serve_rendered": true,
      "serve_data": false
    },
    "onyx": {
      "style": "onyx/style.json",
      "serve_rendered": true,
      "serve_data": false
    },
    "terra": {
      "style": "terra/style.json",
      "serve_rendered": true,
      "serve_data": false
    },
    "fjord": {
      "style": "fjord/style.json",
      "serve_rendered": true,
      "serve_data": false
    },
    "meridian": {
      "style": "meridian/style.json",
      "serve_rendered": true,
      "serve_data": false
    }
  },
  "data": {
    "openmaptiles": {
      "pmtiles": "openmaptiles.pmtiles",
      "sparse": false
    }
  }
}
